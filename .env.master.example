# ──────────────────────────────────────────────────────────────
# Voice-Satellite Master – .env.master.example (2.0.0alpha)
# Kopieren nach .env.master und anpassen
# ──────────────────────────────────────────────────────────────

# API
API_HOST=0.0.0.0
API_PORT=8791
LOG_LEVEL=INFO

# Fileserver-Index
MUSIC_ROOT=/m
CACHE_DIR=/data/vs-index

# SSH für Raspi-Verwaltung (Pi-User ist 'pi', Key = Master-Key via Volume-Mount)
SSH_USER=pi
SSH_PKEY=~/.ssh/vs_master_ed25519

# Raspi-Discovery
SATELLITE_NETWORK=192.168.1.0/24
SATELLITE_HEARTBEAT_SEC=60
SATELLITE_MAX_MISSED=5

# Master-URL (für Satelliten – wo sie den Index holen)
# Wird im Satelliten als MASTER_URL gesetzt
# MASTER_URL=http://dev-server:8791/api/music

# ── Satelliten-Zugang (MASTER_TOKEN) ───────────────────────────
# Token, mit dem Satelliten den Master ansprechen: Heartbeat
# (POST /api/satellite/<mac>/heartbeat) und Config-Pull
# (GET /api/config/apply?mac=...). Ohne Wert bleibt der Zugang offen.
# Prioritaet: Secret im Config-Store (WebUI, Bereich "Secrets") schlagen
# diesen ENV-Wert; der ENV-Wert ist der Fallback fuer den ersten Start.
# Jeder Satellit setzt denselben Wert als MASTER_TOKEN in seiner .env.
# Erzeugen:  openssl rand -hex 24
MASTER_TOKEN=
