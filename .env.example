# Secrets & Konfiguration – als .env neben dem Container ablegen
# (chmod 600 .env – die Datei NIEMALS ins Git)
# Nicht gesetzte Werte nutzen die Defaults aus app/config.py.

# ── openHAB API ────────────────────────────────────────────────
# OPENHAB_URL: REST-API-Basis (openHAB: Settings → Other Services → REST API)
# Beispiel (eigene IP/Hostname einsetzen):
OPENHAB_URL=http://192.168.1.10:8080/rest/items
OPENHAB_TOKEN=
OPENHAB_CACHE_TTL=300

# ── STT API (Whisper) ──────────────────────────────────────────
# Beispiel: Whisper-Server (faster-whisper-Server) auf eigener IP:
STT_URL=http://192.168.1.20:9000/v1/audio/transcriptions
STT_MODEL=whisper-1
# fest Deutsch, sonst raet Whisper und liefert Englisch
STT_LANGUAGE=de
STT_TIMEOUT=30

# ── TTS API (Piper) ────────────────────────────────────────────
TTS_URL=http://192.168.1.20:5000/v1/audio/speech
# Zugriffstoken des Piper-Servers
TTS_TOKEN=
TTS_MODEL=piper
TTS_VOICE=kitt
# Sprache der Synthese (API-Feld "language"); leer = Server-Default
TTS_LANGUAGE=de
TTS_TIMEOUT=60

# ── LLM API ────────────────────────────────────────────────────
# Chat-Kompletions-API (z.B. Ollama, vLLM oder LiteLLM) – eigene IP/Port:
LLM_URL=http://192.168.1.20:11434/v1/chat/completions
# Ollama braucht kein Token; bei LiteLLM/anderem den Key setzen
LLM_TOKEN=
# klein + schnell: ~1,4s. Groessere Modelle (qwen2.5:7b, gemma4:e4b) = ~20s
LLM_MODEL=qwen2.5:3b
LLM_TIMEOUT=30
# Reine Chat-Endpunkte (vLLM/Ollama): Thinking aus = schneller; Antwort liegt
# dann je nach Stack in content oder reasoning_content – beide werden gelesen.
LLM_ENABLE_THINKING=false
LLM_MAX_TOKENS=1024
# Werkzeug-Modus: true|false|auto. 'auto' erkennt Agent-Endpunkte (z.B. ein
# Hermes-Gateway mit Modell hermes-agent) an URL/Modellname. Agent-Endpunkte
# bekommen dann einen Systemprompt, der sie zwingt, Uhrzeit/Datum per Kommando
# (date) nachzusehen statt zu raten – und keine chat-only-Felder wie
# keep_alive/chat_template_kwargs.
LLM_HAS_TOOLS=auto

# ── Audio ──────────────────────────────────────────────────────
# plughw konvertiert softwareseitig (Mic 44.1k->16k; Piper-WAVs 22050 Hz)
# aplay -l liefert die gelaengten Index-Zahlen des eigenen Geraets
MIC_DEVICE=plughw:1,0
SPEAKER_DEVICE=plughw:0,0

# ── Wake-Word (15 Varianten im Image unter /app/wake/) ─────────
# WAKE_PPN = Pfad zur .ppn-Datei. Verfügbare Wörter (Dateiname =
#   <wort>_raspberry-pi.ppn): alexa, americano, blueberry, bumblebee,
#   computer, grapefruit, grasshopper, "hey google", "hey siri", jarvis,
#   "ok google", "pico clock", picovoice, porcupine, terminator
# Beispiel Umstellung:
#WAKE_PPN=/app/wake/hey siri_raspberry-pi.ppn
WAKE_PPN=/app/wake/computer_raspberry-pi.ppn
# Anzeige-Text fürs UI (kein technischer Bezug zur .ppn):
WAKE_WORD=Computer

# ── Follow-up-Modus ────────────────────────────────────────────
# Nach einer Antwort ohne neues Codewort weitersprechen.
# FOLLOWUP_SEC Stille ohne Spracheingabe -> zurück zum Codewort.
FOLLOWUP=1
FOLLOWUP_SEC=3.0
# Sicherheitsbremse: max. Folgen-Runden pro Session
FOLLOWUP_MAX=10

# ── Framebuffer-Display (Antworten als Text auf dem Pi-Display) ─
# /dev/fb1 muss im Container existieren (compose reicht es durch,
# Container braucht die video-Gruppe). 480x320, 16-Bit RGB565.
# Kein fbi/Pillow noetig – direct write.
FB_DEVICE=/dev/fb1
FB_WIDTH=480
FB_HEIGHT=320
# s ohne neuen Inhalt, dann dunkel:
FB_TIMEOUT=60
# s pro Seite bei langen Antworten (Auto-Blättern):
FB_PAGE_SEC=5

# ── Alarmton / Toene ───────────────────────────────────────────
# Toene (Hz): wake 880, end 523, boot 660+1320 (2× Oktave), error 220.
# Alarm = 2-Ton-Sirene (880/440, A5+A4). TONE_ALARM_REPEATS = Halbzyklen.
TONE_GAIN=0.25
TONE_SEC=0.15
TONE_WAKE_HZ=880
TONE_END_HZ=523
TONE_BOOT_HZ=660
TONE_BOOT2_HZ=1320
TONE_ERROR_HZ=220
TONE_ALARM_HZ=880
TONE_ALARM_HZ2=440
TONE_ALARM_REPEATS=3

# ── Verhalten ──────────────────────────────────────────────────
WAKE_SENS=0.5
# energy | webrtc (webrtc nur x86-Testumgebung)
VAD_MODE=energy
SILENCE_SEC=1.3
MAX_REC_SEC=12
LOG_LEVEL=INFO
# HTTP-Interface (Debug-UI, /speak, /tone, /intent):
WEB_PORT=8770

# ── Musik-Ducking ──────────────────────────────────────────────
# Beim Codewort die Musik NICHT stoppen, nur leiser (amixer) und am
# Session-Ende wiederherstellen. Während STT/LLM läuft die Musik auf
# DUCK_VOLUME weiter; bei TTS erklingt die Antwort im Normalpegel
# (Pre-Duck-Lautstärke) über der Pause.
DUCK_ENABLED=1
DUCK_VOLUME=30
