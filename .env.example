# Secrets & Konfiguration – als .env neben docker-compose.yml ablegen
# (chmod 600 .env – die Datei NIEMALS ins Git)
# Nicht gesetzte Werte nutzen die Defaults aus app/config.py.

# ── openHAB API ────────────────────────────────────────────────
# OPENHAB_URL: REST-API-Basis (openHAB: Settings → Other Services → REST API)
OPENHAB_URL=http://openhab.example.net:8080/rest/items
OPENHAB_TOKEN=
OPENHAB_CACHE_TTL=300

# ── STT API (Whisper auf 192.168.1.31) ───────────────────────
STT_URL=http://192.168.1.31:9000/v1/audio/transcriptions
STT_MODEL=whisper-1
# fest Deutsch, sonst raet Whisper und liefert Englisch
STT_LANGUAGE=de
STT_TIMEOUT=30

# ── TTS API (Piper auf 192.168.1.33) ─────────────────────────
TTS_URL=http://192.168.1.33:5000/v1/audio/speech
# Zugriffstoken des Piper-Servers
TTS_TOKEN=
TTS_MODEL=kitt
TTS_VOICE=kitt
TTS_TIMEOUT=60

# ── LLM API (Ollama auf 192.168.1.31) ────────────────────────
# Bewusst Ollama und NICHT das Hermes-Gateway (:8642): der Agent dort haelt
# Aktionen zurueck ("Freigabe erforderlich") und halluziniert bei offenen
# Fragen. Ein plain Chat-Model ist fuer Voice richtig.
LLM_URL=http://192.168.1.31:11434/v1/chat/completions
# Ollama braucht kein Token
LLM_TOKEN=
# klein + schnell: ~1,4s. Groessere Modelle (qwen2.5:7b, gemma4:e4b) = ~20s
LLM_MODEL=qwen2.5:3b
LLM_TIMEOUT=30

# ── Audio ──────────────────────────────────────────────────────
# plughw konvertiert softwareseitig (Mic 44.1k->16k; Piper-WAVs 22050 Hz)
MIC_DEVICE=plughw:2,0
SPEAKER_DEVICE=plughw:1,0

# ── Verhalten ──────────────────────────────────────────────────
WAKE_SENS=0.5
# energy | webrtc (webrtc nur x86-Testumgebung)
VAD_MODE=energy
SILENCE_SEC=1.3
LOG_LEVEL=INFO
