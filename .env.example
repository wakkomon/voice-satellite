# Secrets & Konfiguration – als .env neben dem Container ablegen
# (chmod 600 .env – die Datei NIEMALS ins Git)
#
# Referenz: jede Variable wird in app/config.py gelesen. Hier ist der Wert,
# der IM Container greift, wenn die Variable in der .env NICHT gesetzt ist.
# Nur was du überschreiben willst, steht hier – alles andere übernimmt der
# Default aus app/config.py. Secrets (TOKEN/PASS) stehen leer, damit nichts
# in ein Repo wandert.
#
# MERGE-Hinweis: scripts/make_env.py ergänzt NUR fehlende Keys – eine laufende
# .env wird bei Deploy/Provision NICHT zurückgesetzt (keine Key-Werte verloren).

# ── Audio (ALSA) ───────────────────────────────────────────────
# plughw konvertiert softwareseitig (Mic 44.1k->16k; Piper-WAVs 22050 Hz).
# aplay -l liefert die gelaengten Index-Zahlen des eigenen Geraets.
MIC_DEVICE=plughw:2,0
SPEAKER_DEVICE=plughw:1,0

# ── Wake-Word (15 Varianten im Image unter /app/wake/) ─────────
# WAKE_PPN = Pfad zur .ppn-Datei. Verfügbare Wörter (Dateiname =
#   <wort>_raspberry-pi.ppn): alexa, americano, blueberry, bumblebee,
#   computer, grapefruit, grasshopper, "hey google", "hey siri", jarvis,
#   "ok google", "pico clock", picovoice, porcupine, terminator
# Beispiel Umstellung:
#WAKE_PPN=/app/wake/hey siri_raspberry-pi.ppn
WAKE_PPN=/app/wake/computer_raspberry-pi.ppn
# Empfindlichkeit: niedriger = empfindlicher (0.5).
WAKE_SENS=0.5
# Anzeige-Text fürs UI (kein technischer Bezug zur .ppn):
WAKE_WORD=Computer

# ── VAD / Sprachende-Erkennung ─────────────────────────────────
# energy | webrtc (webrtc nur x86-Testumgebung)
VAD_MODE=energy
# Aggressivität der webrtc-VAD (0-3), nur bei VAD_MODE=webrtc wirksam:
VAD_AGGRESSIVENESS=3
# Energie-Schwelle für energy-VAD (1200):
ENERGY_THRESHOLD=1200
# s Stille = Ende der Sprache:
SILENCE_SEC=1.3
# min./max. Aufnahme-Länge (s):
MIN_REC_SEC=0.4
MAX_REC_SEC=27
# Vorlauf, damit der Satzanfang nicht fehlt (s):
PREROLL_SEC=0.3
# Rest des Codeworts verwerfen, bevor STT startet (s):
WAKE_SKIP_SEC=0.35

# ── STT API (Whisper) ──────────────────────────────────────────
STT_URL=http://192.168.1.31:9000/v1/audio/transcriptions
STT_MODEL=whisper-1
# fest Deutsch, sonst raet Whisper und liefert Englisch:
STT_LANGUAGE=de
STT_TIMEOUT=30

# ── openHAB API (Kontext für LLM + Smart-Home-Intent) ──────────
# REST-API-Basis (openHAB: Settings → Other Services → REST API):
OPENHAB_URL=http://openhab.example.net:8080/rest/items
OPENHAB_TOKEN=
# Item-Liste cachen (s):
OPENHAB_CACHE_TTL=300
# Pfad zur lokalen Regelungsdatei (YAML-Regeln):
RULES_FILE=/data/rules.yaml

# ── LLM API ────────────────────────────────────────────────────
# Chat-Kompletions-API (z.B. Ollama, vLLM oder LiteLLM) – eigene IP/Port:
LLM_URL=http://192.168.1.33:8642/v1/chat/completions
# Ollama braucht kein Token; bei LiteLLM/anderem den Key setzen:
LLM_TOKEN=
# Hermes-Gateway-Agent mit Terminal-Zugriff (Gateway-URL :8642 aktiviert Werkzeug-Modus):
LLM_MODEL=hermes-agent
# Kaltstart Gateway-Agent (inkl. Werkzeug-Discovery):
LLM_TIMEOUT=180
# mit Thinking-aus reicht 1024 fuer Voice-Antworten:
LLM_MAX_TOKENS=1024
# Reine Chat-Endpunkte (vLLM/Ollama): Thinking aus = schneller; Antwort liegt
# dann je nach Stack in content oder reasoning_content – beide werden gelesen.
LLM_ENABLE_THINKING=false
# Werkzeug-Modus: true|false|auto. 'auto' erkennt Agent-Endpunkte (z.B. ein
# Hermes-Gateway mit Modell hermes-agent) an URL/Modellname. Agent-Endpunkte
# bekommen dann einen Systemprompt, der sie zwingt, Uhrzeit/Datum per Kommando
# (date) nachzusehen statt zu raten – und keine chat-only-Felder wie
# keep_alive/chat_template_kwargs.
LLM_HAS_TOOLS=auto

# ── Langzeitgedächtnis (SQLite) ────────────────────────────────
MEMORY_DB=/data/memory.db
# Nachrichten im Kurzzeitgedächtnis:
MAX_HISTORY=20
# max. Facts im Langzeitgedächtnis:
MAX_FACTS=100

# ── TTS API (Piper) ────────────────────────────────────────────
TTS_URL=http://192.168.1.33:5000/v1/audio/speech
# Zugriffstoken des Piper-Servers:
TTS_TOKEN=
TTS_MODEL=piper
TTS_VOICE=kitt
# Sprache der Synthese (API-Feld "language"); Standard: Deutsch
TTS_LANGUAGE=de
TTS_TIMEOUT=60

# ── Alarmton / Toene ───────────────────────────────────────────
# Toene (Hz): wake 880, end 523, boot 660+1320 (2x Oktave), error 220.
# Alarm = 2-Ton-Sirene (880/440, A5+A4). TONE_ALARM_REPEATS = Halbzyklen.
TONE_GAIN=0.5
TONE_SEC=0.15
TONE_WAKE_HZ=880
TONE_END_HZ=523
TONE_BOOT_HZ=660
TONE_BOOT2_HZ=1320
TONE_ERROR_HZ=220
TONE_ALARM_HZ=880
TONE_ALARM_HZ2=440
TONE_ALARM_REPEATS=3
# Kurz-Blip: Lautstärke-Feedback (Web-UI), Dauer in s:
TONE_BLIP_SEC=0.10

# ── Follow-up-Modus ────────────────────────────────────────────
# Nach einer Antwort ohne neues Codewort weitersprechen.
# FOLLOWUP_SEC Stille ohne Spracheingabe -> zurück zum Codewort.
FOLLOWUP=1
FOLLOWUP_SEC=3.0
# Sicherheitsbremse: max. Folgen-Runden pro Session:
FOLLOWUP_MAX=10

# ── Lautstärke (amixer) ────────────────────────────────────────
# Prozent-Schritt pro Stufe: "lauter"/"leiser" ändern die Lautstärke immer
# um genau EINE Stufe (nicht auf einen absoluten Wert).
VOLUME_STEP=10

# ── Musik-Ducking ──────────────────────────────────────────────
# Beim Codewort die Musik NICHT stoppen, nur leiser (amixer) und am
# Session-Ende wiederherstellen. Während STT/LLM läuft die Musik auf
# DUCK_VOLUME weiter; bei TTS erklingt die Antwort im Normalpegel
# (Pre-Duck-Lautstärke) über der Pause.
DUCK_ENABLED=1
DUCK_VOLUME=30

# ── Musik-Player (mpg123: Dateien vom SMB-Share + Radio-Streams) ─
# Wurzelordner aller Musik-/Medien-Dateien IM CONTAINER.
# Standard /m = read-only Bind-Mount des Fileserver-Share.
# Relative Pfade in POST /play {path:"mp3/…"} beziehen sich auf MUSIC_ROOT.
MUSIC_ROOT=/m

# ── Framebuffer-Display (Antworten als Text auf dem Pi-Display) ─
# /dev/fb1 muss im Container existieren (compose reicht es durch,
# Container braucht die video-Gruppe). 480x320, 16-Bit RGB565.
# Kein fbi/Pillow noetig – direct write.
FB_DEVICE=/dev/fb1
FB_WIDTH=480
FB_HEIGHT=320
# Schrift-Vergrößerungsfaktor (4 = gut lesbar auf 480x320):
FB_FONT_SCALE=4
# s ohne neuen Inhalt, dann dunkel:
FB_TIMEOUT=60
# s pro Seite bei langen Antworten (Auto-Blättern):
FB_PAGE_SEC=5

# ── Idle-Display (Wetter-/Standardbild) ────────────────────────
# Der Container blittet ein vorge-rendertes Frame aus IDLE_FRAME_DIR.
# Das Host-Skript render_idle.py (Root-Cron) lädt DEFAULT_IMAGE_URL,
# rendert es nach RGB565 (480x320) und legt es als .bin ab.
IDLE_TICK_SEC=30
IDLE_FRAME_DIR=/data/idle
# s ohne neues Frame → dunkel:
IDLE_TIMEOUT=5
# 1 = Musik-Info im Idle zeigen:
IDLE_SHOW_MUSIC=1
# Quell-URL für das Idle-Standardbild (Default = Wetter-Snapshot):
DEFAULT_IMAGE_URL=http://192.168.1.33/weather/snap.jpg

# ── Pi-Bridge (RTSP-Relay + Kamera-Snapshot) ──────────────────
BRIDGE_HOST=192.168.1.32
BRIDGE_PORT=8790
# RTSP-Zugang der Kamera (leer = kein Login):
RTSP_USER=
RTSP_PASS=

# ── Verhalten ──────────────────────────────────────────────────
LOG_LEVEL=INFO
# HTTP-Interface (Debug-UI, /speak, /tone, /intent):
WEB_PORT=8770
