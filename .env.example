# Secrets & Konfiguration – als .env neben dem Container ablegen
# (chmod 600 .env – die Datei NIEMALS ins Git)
# Nicht gesetzte Werte nutzen die Defaults aus app/config.py.

# ── openHAB API ────────────────────────────────────────────────
# OPENHAB_URL: REST-API-Basis (openHAB: Settings → Other Services → REST API)
# Beispiel (eigene IP/Hostname einsetzen):
OPENHAB_URL=http://192.168.1.10:8080/rest/items
OPENHAB_TOKEN=
OPENHAB_CACHE_TTL=300

# ── STT API (Whisper) ──────────────────────────────────────────
# Beispiel: Whisper-Server (faster-whisper-Server) auf eigener IP:
STT_URL=http://192.168.1.20:9000/v1/audio/transcriptions
STT_MODEL=whisper-1
# fest Deutsch, sonst raet Whisper und liefert Englisch
STT_LANGUAGE=de
STT_TIMEOUT=30

# ── TTS API (Piper) ────────────────────────────────────────────
TTS_URL=http://192.168.1.20:5000/v1/audio/speech
# Zugriffstoken des Piper-Servers
TTS_TOKEN=
TTS_MODEL=kitt
TTS_VOICE=kitt
TTS_TIMEOUT=60

# ── LLM API ────────────────────────────────────────────────────
# Chat-Kompletions-API (z.B. Ollama, vLLM oder LiteLLM) – eigene IP/Port:
LLM_URL=http://192.168.1.20:11434/v1/chat/completions
# Ollama braucht kein Token; bei LiteLLM/anderem den Key setzen
LLM_TOKEN=
# klein + schnell: ~1,4s. Groessere Modelle (qwen2.5:7b, gemma4:e4b) = ~20s
LLM_MODEL=qwen2.5:3b
LLM_TIMEOUT=30
# Reine Chat-Endpunkte (vLLM/Ollama): Thinking aus = schneller; Antwort liegt
# dann je nach Stack in content oder reasoning_content – beide werden gelesen.
LLM_ENABLE_THINKING=false
LLM_MAX_TOKENS=1024
# Werkzeug-Modus: true|false|auto. 'auto' erkennt Agent-Endpunkte (z.B. ein
# Hermes-Gateway mit Modell hermes-agent) an URL/Modellname. Agent-Endpunkte
# bekommen dann einen Systemprompt, der sie zwingt, Uhrzeit/Datum per Kommando
# (date) nachzusehen statt zu raten – und keine chat-only-Felder wie
# keep_alive/chat_template_kwargs.
LLM_HAS_TOOLS=auto

# ── Audio ──────────────────────────────────────────────────────
# plughw konvertiert softwareseitig (Mic 44.1k->16k; Piper-WAVs 22050 Hz)
# aplay -l liefert die gelaengten Index-Zahlen des eigenen Geraets
MIC_DEVICE=plughw:1,0
SPEAKER_DEVICE=plughw:0,0

# ── Verhalten ──────────────────────────────────────────────────
WAKE_SENS=0.5
# energy | webrtc (webrtc nur x86-Testumgebung)
VAD_MODE=energy
SILENCE_SEC=1.3
LOG_LEVEL=INFO
