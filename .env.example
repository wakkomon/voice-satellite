# Secrets & Konfiguration – als .env neben dem Container ablegen
# (chmod 600 .env – die Datei NIEMALS ins Git)
#
# Referenz: jede Variable wird in app/config.py gelesen. Hier ist der Wert,
# der IM Container greift, wenn die Variable in der .env NICHT gesetzt ist.
# Die Defaults sind die Live-Werte des Pi (Stand 2026-10-11).
#
# MERGE-Hinweis: scripts/make_env.py ergänzt NUR fehlende Keys – eine laufende
# .env wird bei Deploy/Provision NICHT zurückgesetzt (keine Werte verloren).
# Die Variable steht alphabetisch sortiert, Secrets (TOKEN/PASS) leer.

# ── A/B ────────────────────────────────────────────────────────
# Framebuffer-Display (Antworten als Text auf dem Pi-Display).
# /dev/fb1 muss im Container existieren (compose reicht es durch,
# Container braucht die video-Gruppe). 480x320, 16-Bit RGB565.
FB_DEVICE=/dev/fb1
FB_FONT_SCALE=4
FB_HEIGHT=320
FB_PAGE_SEC=5
FB_TIMEOUT=60
FB_WIDTH=480
# Pi-Bridge (RTSP-Relay + Kamera-Snapshot):
BRIDGE_HOST=192.168.1.32
BRIDGE_PORT=8790
# RTSP-Zugang der Kamera (leer = kein Login):
RTSP_PASS=
RTSP_USER=

# ── D/F ────────────────────────────────────────────────────────
# Quell-URL für das Idle-Standardbild (Default = Wetter-Snapshot).
# Das Host-Skript render_idle.py (Root-Cron) lädt diese URL und rendert
# sie nach RGB565 nach IDLE_FRAME_DIR; der Container blittet das Frame.
DEFAULT_IMAGE_URL=http://192.168.1.33/weather/snap.jpg
# Beim Codewort die Musik NICHT stoppen, nur leiser (amixer) und am
# Session-Ende wiederherstellen. 0 = Ducking deaktiviert.
DUCK_ENABLED=1
DUCK_VOLUME=30
# s ohne neues Frame → dunkel / s zwischen Idle-Updates:
IDLE_FRAME_DIR=/data/idle
IDLE_SHOW_MUSIC=1
IDLE_TICK_SEC=30
IDLE_TIMEOUT=5

# ── L/M ────────────────────────────────────────────────────────
# Log-Stufe (DEBUG | INFO | WARNING):
LOG_LEVEL=INFO
# Chat-Kompletions-API (Hermes-Gateway :8642, Modell hermes-agent –
# echter Agent MIT Terminal; Gateway-URL/Modellname aktivieren den
# Werkzeug-Modus):
LLM_ENABLE_THINKING=false
LLM_HAS_TOOLS=auto
# mit Thinking-aus reicht 1024 für Voice-Antworten:
LLM_MAX_TOKENS=1024
LLM_MODEL=hermes-agent
# Client-Secret des Hermes-Gateways (Secret – bleibt lokal, nie ins Repo):
LLM_TOKEN=
LLM_URL=http://192.168.1.33:8642/v1/chat/completions
# Kaltstart Gateway-Agent (inkl. Werkzeug-Discovery):
LLM_TIMEOUT=180
# max. Fakten im Langzeitgedächtnis / Nachrichten im Kurzzeitgedächtnis:
MAX_FACTS=100
MAX_HISTORY=20
# max./min. Aufnahme-Länge (s) + Vorlauf, damit der Satzanfang nicht fehlt:
MAX_REC_SEC=27
MIN_REC_SEC=0.4
# Langzeitgedächtnis (SQLite, shared Volume /data):
MEMORY_DB=/data/memory.db
# USB PCM2902; plughw konvertiert 44.1k→16k:
MIC_DEVICE=plughw:2,0
# Wurzelordner aller Musik-/Medien-Dateien IM CONTAINER.
# /m = read-only Bind-Mount des Fileserver-Share
# (docker run -v /media/private:/m:ro); relative Pfade in POST /play
# {path: "mp3/…"} beziehen sich auf MUSIC_ROOT.
MUSIC_ROOT=/m
# Vorlauf/Rest-Codewort in s (0.3 Vorlauf / 0.35 Rest verwerfen):
PREROLL_SEC=0.3
WAKE_SKIP_SEC=0.35

# ── O ──────────────────────────────────────────────────────────
# Item-Liste cachen (s):
OPENHAB_CACHE_TTL=300
# Bearer-Token der REST-API (Secret – bleibt lokal, nie ins Repo):
OPENHAB_TOKEN=
# REST-API-Basis (openHAB: Settings → Other Services → REST API):
OPENHAB_URL=http://openhab.example.net:8080/rest/items

# ── R/S ────────────────────────────────────────────────────────
# Pfad zur lokalen Regelungsdatei (YAML-Regeln):
RULES_FILE=/data/rules.yaml
# s Stille = Ende der Sprache:
SILENCE_SEC=1.3
# bcm2835 Headphones; plughw für die TTS-WAVs:
SPEAKER_DEVICE=plughw:1,0
# STT API (Whisper auf .31):
STT_LANGUAGE=de
STT_MODEL=whisper-1
STT_TIMEOUT=30
STT_URL=http://192.168.1.31:9000/v1/audio/transcriptions
# Sprache der Synthese (API-Feld "language"):
TTS_LANGUAGE=de
TTS_MODEL=piper
# Zugriffstoken des TTS-Servers (Secret – bleibt lokal, nie ins Repo):
TTS_TOKEN=
TTS_TIMEOUT=60
TTS_URL=http://192.168.1.33:5000/v1/audio/speech
TTS_VOICE=kitt
# Alarmton / Töne (Hz): wake 880, end 523, boot 660+1320 (2× Oktave),
# error 220, alarm 2-Ton-Sirene (880/440). TONE_ALARM_REPEATS = Halbzyklen.
TONE_ALARM_HZ=880
TONE_ALARM_HZ2=440
TONE_ALARM_REPEATS=3
TONE_BLIP_SEC=0.10
TONE_BOOT2_HZ=1320
TONE_BOOT_HZ=660
TONE_END_HZ=523
TONE_ERROR_HZ=220
TONE_GAIN=0.5
TONE_SEC=0.15
TONE_WAKE_HZ=880

# ── V/W ────────────────────────────────────────────────────────
# energy | webrtc (webrtc nur x86-Testumgebung):
VAD_AGGRESSIVENESS=3
VAD_MODE=energy
# Energie-Schwelle für energy-VAD:
ENERGY_THRESHOLD=1200
# Prozent-Schritt pro Stufe: "lauter"/"leiser" ändern die Lautstärke immer
# um genau EINE Stufe (nicht auf einen absoluten Wert).
VOLUME_STEP=10
# HTTP-Interface (Debug-UI, /speak, /tone, /intent):
WEB_PORT=8770
# Energie-VAD: WAKE_SENS = Empfindlichkeit (niedriger = empfindlicher).
WAKE_SENS=0.5
# WAKE_PPN = Pfad zur .ppn-Datei. Verfügbare Wörter (Dateiname =
#   <wort>_raspberry-pi.ppn): alexa, americano, blueberry, bumblebee,
#   computer, grapefruit, grasshopper, "hey google", "hey siri", jarvis,
#   "ok google", "pico clock", picovoice, porcupine, terminator
#WAKE_PPN=/app/wake/hey siri_raspberry-pi.ppn
WAKE_PPN=/app/wake/computer_raspberry-pi.ppn
# Anzeige-Text fürs UI (kein technischer Bezug zur .ppn):
WAKE_WORD=Computer

# ── Follow-up-Modus ────────────────────────────────────────────
# Nach einer Antwort ohne neues Codewort weitersprechen.
# FOLLOWUP_SEC Stille ohne Spracheingabe → zurück zum Codewort.
FOLLOWUP=1
FOLLOWUP_MAX=10
FOLLOWUP_SEC=3.0
