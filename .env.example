# Secrets & optionale Overrides – als .env neben docker-compose.yml ablegen
# (chmod 600 .env – die Datei NIEMALS ins Git)

# openHAB REST-API Token (http://openhab.example.net:8080)
OPENHAB_TOKEN=

# Hermes/LLM-Gateway (http://192.168.1.33:8642)
LLM_TOKEN=
LLM_MODEL=

# Piper-TTS (http://192.168.1.33:5000)
TTS_TOKEN=

# Audio
MIC_DEVICE=plughw:2,0
SPEAKER_DEVICE=plughw:1,0

# Verhalten
WAKE_SENS=0.5
VAD_MODE=energy          # energy | webrtc (webrtc nur x86-Testumgebung)
SILENCE_SEC=1.3
LOG_LEVEL=INFO
